void setup() {
  // c'est l'initialisation taa serial communication at 9600 bits per second
  Serial.begin(9600);
}

void loop() {
  int sensorValue=analogRead(A0);  //lire l'input on A0 pin
  Serial.println(sensorValue); //print out the value you read
  delay(1000); //delay entre reads 
}
